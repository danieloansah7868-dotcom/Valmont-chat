{
  "name": "vchat",
  "version": "1.0.0",
  "description": "Vchat — secure staged real-time messaging and calling PWA",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test test/*.test.js",
    "check": "node --check server.js && node --check lib/*.js && node --check scripts/*.js && node --check public/app.js && node --check public/sw.js",
    "check:env": "node scripts/check-env.js",
    "backup:local": "node scripts/backup-local.js",
    "restore:local": "node scripts/restore-local.js",
    "ci": "npm run check && npm test && npm audit --audit-level=high"
  },
  "keywords": [
    "chat",
    "messaging",
    "real-time",
    "socketio"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.2.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "multer": "^2.2.0",
    "socket.io": "^4.7.5",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3"
  }
}
