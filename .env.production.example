# Canonical public identity
NODE_ENV=production
PORT=3000
PUBLIC_APP_URL=https://chat.example.com
ALLOWED_ORIGINS=https://chat.example.com
TRUST_PROXY=loopback,linklocal,uniquelocal
PASSKEY_ORIGIN=https://chat.example.com
PASSKEY_RP_ID=example.com

# Transitional pilot only. Omit this to fail closed (the recommended default).
# The bundled adapter cannot run more than one replica.
ALLOW_TRANSITIONAL_LOCAL_STORAGE=true
WEB_CONCURRENCY=1
VCHAT_DATA_DIR=/var/lib/vchat
VCHAT_MEDIA_DIR=/var/lib/vchat/media

# Real phone verification. The SID is AC plus 32 hex characters; the provider
# token is 32 alphanumeric characters. Placeholder/low-entropy values are rejected.
TWILIO_ACCOUNT_SID=replace-me
TWILIO_AUTH_TOKEN=replace-me
TWILIO_FROM=+15550000000

# Calling relay (comma-separated TURN/TURNS URLs). Use at least 32 random bytes;
# placeholder/low-entropy values are rejected.
TURN_URLS=turns:turn.example.com:5349
TURN_SECRET=replace-me

# Paid Status boosts are off unless this is exactly true.
ENABLE_PAID_STORY_BOOSTS=false
# VALMONTPAY_SECRET_KEY=replace-with-at-least-32-random-bytes
# VALMONTPAY_API_URL=https://valmontpay.app
# STORY_AD_ADMIN_PHONES=+233000000000

# Operations
METRICS_TOKEN=replace-with-a-long-random-secret
LOG_REQUESTS=true
SHUTDOWN_TIMEOUT_MS=10000
READINESS_MIN_FREE_MB=16
API_RATE_WINDOW_MS=60000
API_RATE_MAX=600

# Account and realtime quotas
MAX_UPLOAD_MB=100
MAX_ACCOUNT_STORAGE_MB=1024
MAX_PENDING_UPLOADS=20
SOCKET_EVENT_RATE_LIMIT=600
SOCKET_MESSAGE_RATE_LIMIT=60
AUTH_RATE_LIMIT=30
CHAT_LOCK_RATE_LIMIT=20
