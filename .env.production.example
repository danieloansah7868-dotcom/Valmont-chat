# Server-only production template. Copy to .env and fill from a secret manager.
# Never commit real values. Never put these secrets in browser JavaScript.
#
# A single-node deployment can start with only the REQUIRED values set:
#   NODE_ENV, TRUST_PROXY, ALLOW_TRANSITIONAL_LOCAL_STORAGE, WEB_CONCURRENCY,
#   VCHAT_DATA_DIR, and either Twilio or SMS_DEV_CODE (see below).
# Everything else is optional and can be added later without redeploying.

NODE_ENV=production
PORT=3000
# Exact reverse-proxy hop count (usually 1) or a trusted subnet. Required for
# rate limits and X-Forwarded-For to be trustworthy.
TRUST_PROXY=1
# Named zones are also valid: loopback,linklocal,uniquelocal

# Canonical HTTPS origin of this deployment. Optional: used for ValmontPay
# return URLs and to cross-check a configured passkey origin. Paid boosts and
# passkeys are disabled while it is unset.
# PUBLIC_APP_URL=https://chat.example.com

# Extra browser origins allowed to call the API, comma-separated.
ALLOWED_ORIGINS=
# Required for the bundled JSON/local-media adapter on a single node.
ALLOW_TRANSITIONAL_LOCAL_STORAGE=true
WEB_CONCURRENCY=1

COOKIE_SECURE=true
SESSION_COOKIE_NAME=__Host-vchat_session
SESSION_TTL_DAYS=30

API_RATE_LIMIT=240
AUTH_RATE_LIMIT=20

VCHAT_DATA_DIR=/var/lib/vchat
# Optional override; defaults to $VCHAT_DATA_DIR/media
# VCHAT_MEDIA_DIR=/var/lib/vchat/media
MAX_UPLOAD_MB=100
REEL_MAX_MB=50
REEL_UPLOAD_LIMIT=20
STORY_MAX_MB=30
STORY_UPLOAD_LIMIT=30

# ── Phone verification ────────────────────────────────────────────────
# Real SMS (optional): set all three Twilio values to send codes by SMS.
# They cost money, so they are optional.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Free fallback (optional): with Twilio unset, set SMS_DEV_CODE=true to show
# the 6-digit code on screen instead. Fine for a small trusted group — anyone
# with the phone number could read it, so switch to Twilio before going public.
SMS_DEV_CODE=true

# WebAuthn chat-lock passkeys (optional). Both must be the canonical HTTPS
# identity. Leave both unset to keep the passkey feature disabled.
# PASSKEY_ORIGIN=https://chat.example.com
# PASSKEY_RP_ID=chat.example.com

# TURN relay for calls behind symmetric NAT (optional). Leave both unset and
# calls use free public STUN. Add both to support stricter networks.
TURN_URLS=
TURN_SECRET=

# Advertiser pilot (optional). Leave empty to keep paid delivery disabled.
VALMONTPAY_SECRET_KEY=
VALMONTPAY_API_URL=https://valmontpay.app
STORY_AD_ADMIN_PHONES=
STORY_HOUSE_AD_NAME=Vchat
STORY_HOUSE_AD_HEADLINE=
STORY_HOUSE_AD_TEXT=
STORY_HOUSE_AD_CTA=Learn more
STORY_HOUSE_AD_URL=
