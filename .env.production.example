# Server-only production template. Copy to .env and fill from a secret manager.
# Never commit real values. Never put these secrets in browser JavaScript.

NODE_ENV=production
PORT=3000
# Exact reverse-proxy hop count (usually 1) or a trusted subnet. Required for
# rate limits and X-Forwarded-For to be trustworthy.
TRUST_PROXY=1
# Canonical HTTPS origin of this deployment. Used for ValmontPay return URLs.
PUBLIC_APP_URL=https://chat.example.com
# Extra browser origins allowed to call the API, comma-separated.
ALLOWED_ORIGINS=

COOKIE_SECURE=true
SESSION_COOKIE_NAME=__Host-vchat_session
SESSION_TTL_DAYS=30

API_RATE_LIMIT=240
AUTH_RATE_LIMIT=20

VCHAT_DATA_DIR=/var/lib/vchat
# Optional override; defaults to $VCHAT_DATA_DIR/media
# VCHAT_MEDIA_DIR=/var/lib/vchat/media
MAX_UPLOAD_MB=100
REEL_MAX_MB=50
REEL_UPLOAD_LIMIT=20
STORY_MAX_MB=30
STORY_UPLOAD_LIMIT=30

# Production SMS fails closed unless all three Twilio values are set.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# WebAuthn chat-lock passkeys. Both must be the canonical HTTPS identity.
PASSKEY_ORIGIN=https://chat.example.com
PASSKEY_RP_ID=chat.example.com

# Optional TURN for calls behind symmetric NAT.
TURN_URLS=
TURN_SECRET=

# Advertiser pilot. Leave empty to keep paid delivery disabled.
VALMONTPAY_SECRET_KEY=
VALMONTPAY_API_URL=https://valmontpay.app
STORY_AD_ADMIN_PHONES=
STORY_HOUSE_AD_NAME=Vchat
STORY_HOUSE_AD_HEADLINE=
STORY_HOUSE_AD_TEXT=
STORY_HOUSE_AD_CTA=Learn more
STORY_HOUSE_AD_URL=
