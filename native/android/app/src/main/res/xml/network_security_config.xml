<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production should be HTTPS. Cleartext is allowed so a local/pilot host can be tested. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
