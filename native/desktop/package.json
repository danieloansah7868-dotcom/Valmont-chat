{
  "name": "vchat-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "VChat desktop shell — navy Cloud, orange SMS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.vchat.desktop",
    "productName": "VChat",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js"],
    "linux": { "target": ["AppImage"] },
    "mac": { "target": ["dmg"] },
    "win": { "target": ["nsis"] }
  }
}
